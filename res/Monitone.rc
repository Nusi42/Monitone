// Icons, version information and (for non-MSVC toolchains) the manifest.
#include <windows.h>

#include "resource.h"
#include "version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

#ifdef MONITONE_EMBED_MANIFEST
1 24 "Monitone.manifest"
#endif

// Generated by tools/icon/make_icon.py.
IDI_APP ICON "Monitone.ico"
IDI_PAUSED ICON "MonitonePaused.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MONITONE_VERSION_MAJOR, MONITONE_VERSION_MINOR, MONITONE_VERSION_PATCH, 0
 PRODUCTVERSION MONITONE_VERSION_MAJOR, MONITONE_VERSION_MINOR, MONITONE_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS MONITONE_VERSION_FLAGS
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Monitone contributors"
      VALUE "FileDescription", "Monitone per-display audio routing"
      VALUE "FileVersion", MONITONE_VERSION_FULL
      VALUE "InternalName", "Monitone"
      VALUE "LegalCopyright", "AGPL-3.0-or-later"
      VALUE "OriginalFilename", "Monitone.exe"
      VALUE "ProductName", "Monitone"
      VALUE "ProductVersion", MONITONE_VERSION_FULL
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
