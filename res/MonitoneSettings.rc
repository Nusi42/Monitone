// Web UI files and version information of MonitoneSettings.dll.
#include <windows.h>

#include "settings/resource.h"
#include "version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDR_UI_INDEX RCDATA "../ui/index.html"
IDR_UI_CSS RCDATA "../ui/app.css"
IDR_UI_JS RCDATA "../ui/app.js"
IDR_UI_ICON RCDATA "Monitone-256.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MONITONE_VERSION_MAJOR, MONITONE_VERSION_MINOR, MONITONE_VERSION_PATCH, 0
 PRODUCTVERSION MONITONE_VERSION_MAJOR, MONITONE_VERSION_MINOR, MONITONE_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS MONITONE_VERSION_FLAGS
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Monitone contributors"
      VALUE "FileDescription", "Monitone settings user interface"
      VALUE "FileVersion", MONITONE_VERSION_FULL
      VALUE "InternalName", "MonitoneSettings"
      VALUE "LegalCopyright", "AGPL-3.0-or-later"
      VALUE "OriginalFilename", "MonitoneSettings.dll"
      VALUE "ProductName", "Monitone"
      VALUE "ProductVersion", MONITONE_VERSION_FULL
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
