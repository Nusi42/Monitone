#!/bin/sh
# Pre-commit hook (core.hooksPath .githooks, set by the first CMake configure).
# Staged C++ files must match .clang-format (check only, never rewrites).
root=$(git rev-parse --show-toplevel) || exit 1
command -v node >/dev/null 2>&1 || { echo "pre-commit: Node.js is required for tools/git/check-format.mjs" >&2; exit 1; }
exec node "$root/tools/git/check-format.mjs"
