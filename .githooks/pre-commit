#!/bin/sh
# Pre-commit hook (core.hooksPath .githooks, set by the first CMake configure).
# No private data in the staged files; staged C++ files must match
# .clang-format (check only, never rewrites).
command -v node >/dev/null 2>&1 || { echo "pre-commit: Node.js is required for tools/git/check-private.mjs" >&2; exit 1; }
node "$(dirname "$0")/../tools/git/check-private.mjs" --staged || exit 1
exec node "$(dirname "$0")/../tools/git/check-format.mjs"
