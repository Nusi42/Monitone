#!/bin/sh
# Pre-push hook (enable once per clone: git config core.hooksPath .githooks).
# Refuses merge commits in what a push adds; git passes the ref lines on stdin.
root=$(git rev-parse --show-toplevel) || exit 1
command -v node >/dev/null 2>&1 || { echo "pre-push: Node.js is required for tools/git/check-linear.mjs" >&2; exit 1; }
exec node "$root/tools/git/check-linear.mjs"
