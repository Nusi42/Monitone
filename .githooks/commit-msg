#!/bin/sh
# Commit-msg hook (core.hooksPath .githooks, set by the first CMake configure).
# Conventional Commits subject, no session links; then no private data in the
# message or the identity, and only the identity in monitone.identity (if set).
# git passes the message file.
command -v node >/dev/null 2>&1 || { echo "commit-msg: Node.js is required for tools/git/check-commit-msg.mjs" >&2; exit 1; }
node "$(dirname "$0")/../tools/git/check-commit-msg.mjs" "$1" || exit 1
exec node "$(dirname "$0")/../tools/git/check-private.mjs" --message "$1"
